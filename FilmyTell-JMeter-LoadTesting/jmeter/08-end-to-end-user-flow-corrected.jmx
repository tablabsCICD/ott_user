<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="FilmyTell End To End Flow - Corrected Auth" enabled="true">
      <stringProp name="TestPlan.comments">FilmyTell OTT Load Test Plan - Strict Auth Failure Control (filmytell.com/ott)</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">BASE_PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(BASE_PROTOCOL,https)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BASE_HOST" elementType="Argument">
            <stringProp name="Argument.name">BASE_HOST</stringProp>
            <stringProp name="Argument.value">${__P(BASE_HOST,filmytell.com)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BASE_PORT" elementType="Argument">
            <stringProp name="Argument.name">BASE_PORT</stringProp>
            <stringProp name="Argument.value">${__P(BASE_PORT,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BASE_PATH" elementType="Argument">
            <stringProp name="Argument.name">BASE_PATH</stringProp>
            <stringProp name="Argument.value">${__P(BASE_PATH,/ott)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">${BASE_PROTOCOL}://${BASE_HOST}${BASE_PATH}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TEST_OTP" elementType="Argument">
            <stringProp name="Argument.name">TEST_OTP</stringProp>
            <stringProp name="Argument.value">${__P(TEST_OTP,123456)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THREAD_COUNT" elementType="Argument">
            <stringProp name="Argument.name">THREAD_COUNT</stringProp>
            <stringProp name="Argument.value">${__P(THREAD_COUNT,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP</stringProp>
            <stringProp name="Argument.value">${__P(RAMP_UP,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DURATION" elementType="Argument">
            <stringProp name="Argument.name">DURATION</stringProp>
            <stringProp name="Argument.value">${__P(DURATION,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_SUCCESS" elementType="Argument">
            <stringProp name="Argument.name">AUTH_SUCCESS</stringProp>
            <stringProp name="Argument.value">false</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${BASE_HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${BASE_PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">${BASE_PROTOCOL}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.path">${BASE_PATH}</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">User-Agent</stringProp>
            <stringProp name="Header.value">FilmyTell-OTT-LoadTest/1.0</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set Config - Users" enabled="true">
        <stringProp name="filename">../data/users.csv</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="variableNames">mobileNumber,deviceId,contentId,userId</stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set Config - Devices" enabled="true">
        <stringProp name="filename">../data/devices.csv</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="variableNames">deviceId,deviceName,deviceType,appVersion</stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="FilmyTell User Journey Thread Group" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${THREAD_COUNT}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration">${DURATION}</stringProp>
      </ThreadGroup>
      <hashTree>
        
        <!-- Transaction Controller 1: AUTH - Authentication Flow -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="AUTH - Authentication Flow" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          
          <!-- AUTH - Send OTP -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="AUTH - Send OTP" enabled="true">
            <stringProp name="HTTPSampler.path">${BASE_PATH}/userNew/SendOTPOnMobileWithRegistration?mobileNumber=${mobileNumber}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree/>

          <!-- AUTH - Verify OTP -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="AUTH - Verify OTP" enabled="true">
            <stringProp name="HTTPSampler.path">${BASE_PATH}/userNew/VerifyOtpJWT?username=${mobileNumber}&amp;mobileNumber=${mobileNumber}&amp;otp=${TEST_OTP}&amp;deviceId=${deviceId}&amp;deviceName=${deviceName}&amp;deviceType=${deviceType}&amp;appVersion=${appVersion}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <!-- Strict Extractor: NO success defaults like NONE or 1 -->
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor - Session and Token" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">accessToken;tokenType;sessionId;userId</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.token;$.data.tokenType;$.data.sessionId;$.data.userId</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1;1;1;1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">;;;</stringProp>
            </JSONPostProcessor>
            <hashTree/>

            <!-- JSR223 Assertion: Groovy Token & Session Validation -->
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="AUTH - JSR223 Token Validation" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
String token = vars.get("accessToken")
String tokenType = vars.get("tokenType")
String sessionId = vars.get("sessionId")
String userId = vars.get("userId")

if (token == null || token.trim().isEmpty() || token.equalsIgnoreCase("NONE") || token.equalsIgnoreCase("null")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Authentication Failed: accessToken is missing or invalid.")
    vars.put("AUTH_SUCCESS", "false")
} else if (sessionId == null || sessionId.trim().isEmpty() || sessionId.equalsIgnoreCase("NONE")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Authentication Failed: sessionId is missing.")
    vars.put("AUTH_SUCCESS", "false")
} else if (userId == null || userId.trim().isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("Authentication Failed: userId is missing.")
    vars.put("AUTH_SUCCESS", "false")
} else {
    vars.put("AUTH_SUCCESS", "true")
    if (tokenType == null || tokenType.trim().isEmpty()) {
        vars.put("tokenType", "Bearer")
    }
}
              </stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- If Controller: Execute Authenticated APIs ONLY if AUTH_SUCCESS == true -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Authentication Succeeded" enabled="true">
          <stringProp name="IfController.condition">${AUTH_SUCCESS} == true</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          
          <!-- Auth Header Guard -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager - Bearer Token" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">${tokenType} ${accessToken}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <!-- Transaction Controller 2: API - Authenticated APIs -->
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="API - Authenticated APIs" enabled="true">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>

            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="API - Filter Content Type3" enabled="true">
              <stringProp name="HTTPSampler.path">${BASE_PATH}/api/forUser/filter/content-list/type3</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
            </HTTPSamplerProxy>
            <hashTree/>

            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="API - Movie Content Details" enabled="true">
              <stringProp name="HTTPSampler.path">${BASE_PATH}/api/ContentList/getContentByIdAndUserId?id=${contentId}&amp;userId=${userId}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
            </HTTPSamplerProxy>
            <hashTree/>

            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="API - Search Content" enabled="true">
              <stringProp name="HTTPSampler.path">${BASE_PATH}/api/forUser/user/Content/getByAnyKey?userId=${userId}&amp;keyword=movie</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
            </HTTPSamplerProxy>
            <hashTree/>

            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="API - Signed Playback URL" enabled="true">
              <stringProp name="HTTPSampler.path">${BASE_PATH}/anti-piracy/playback/signed-url</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <stringProp name="Argument.value"><![CDATA[{
  "contentId": "${contentId}",
  "deviceId": "${deviceId}",
  "playbackUrl": "https://filmytell.com/hls/sample_stream.m3u8",
  "country": "IN",
  "deviceIntegrity": "VERIFIED"
}]]></stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree/>

            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="API - Get User Profile" enabled="true">
              <stringProp name="HTTPSampler.path">${BASE_PATH}/user/getUser/${userId}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
            </HTTPSamplerProxy>
            <hashTree/>

          </hashTree>
        </hashTree>
        
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>